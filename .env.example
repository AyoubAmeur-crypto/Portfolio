# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:5000"

# EMAIL CONFIGURATION for the contact form
# EMAIL_USER is your gmail address
EMAIL_USER="your-email@gmail.com"
# EMAIL_PASS is your 16-character App Password from Google Account Security
EMAIL_PASS="your-app-password-here"

# GITHUB CONFIGURATION for the contribution graph
# GITHUB_TOKEN is a Personal Access Token created in your GitHub settings (requires read:user scope)
GITHUB_TOKEN="your_github_personal_access_token_here"
# GITHUB_USERNAME is your github username
GITHUB_USERNAME="your-github-username"

